<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E1E1E"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <com.rfidresearchgroup.common.widget.StatusBarHeightView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📱 Spieler Registrieren"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registriere neue Spieler mit NFC-Tags"
            android:textSize="16sp"
            android:textColor="#AAAAAA"
            android:gravity="center"
            android:layout_marginBottom="48dp" />

        <!-- Input Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_team_border"
            android:padding="20dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Spielername"
                android:textSize="14sp"
                android:textColor="#AAAAAA"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/edtName"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="Max Mustermann"
                android:textColorHint="#666666"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/bg_rounded_white"
                android:backgroundTint="#2E2E2E"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💡 Der Name wird zusammen mit einer eindeutigen ID auf dem NFC-Tag gespeichert"
                android:textSize="12sp"
                android:textColor="#888888"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Action Buttons -->
        <Button
            android:id="@+id/btnWriteName"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:text="📝 Auf NFC-Tag schreiben"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_rounded_teal"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnReadName"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="🔍 Von NFC-Tag lesen"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_rounded_teal"
            android:backgroundTint="#2E2E2E"
            android:layout_marginBottom="32dp" />

        <!-- Result Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_team_border"
            android:padding="20dp"
            android:minHeight="150dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Status"
                android:textSize="14sp"
                android:textColor="#AAAAAA"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/txtResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bereit für NFC-Operationen...\n\nBitte Tag an Leser halten wenn du eine Aktion ausführst."
                android:textSize="15sp"
                android:textColor="#CCCCCC"
                android:lineSpacingMultiplier="1.3" />
        </LinearLayout>

        <!-- Info Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="32dp"
            android:padding="16dp"
            android:background="@drawable/bg_rounded_white"
            android:backgroundTint="#AA000000">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ℹ️ So funktioniert's:"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#4DD0E1"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Namen eingeben\n2. NFC-Tag an Leser halten\n3. 'Auf NFC-Tag schreiben' drücken\n4. Tag ist registriert!"
                android:textSize="13sp"
                android:textColor="#AAAAAA"
                android:lineSpacingMultiplier="1.5" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>
