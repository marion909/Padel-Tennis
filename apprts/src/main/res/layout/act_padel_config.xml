<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#1E1E1E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Padel Tennis Scorer"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configure Your Match"
            android:textSize="16sp"
            android:textColor="#AAAAAA"
            android:layout_gravity="center"
            android:layout_marginBottom="32dp" />

        <!-- Players Per Team -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Players Per Team"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <RadioGroup
            android:id="@+id/rgTeams"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="32dp">

            <RadioButton
                android:id="@+id/rbTeams2"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="1"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:button="@null"
                android:background="@drawable/radio_button_selector"
                android:layout_marginEnd="8dp" />

            <RadioButton
                android:id="@+id/rbTeams4"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="2"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:button="@null"
                android:background="@drawable/radio_button_selector"
                android:layout_marginStart="8dp"
                android:checked="true" />
        </RadioGroup>

        <!-- Golden Point -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Game Mode at Deuce (40-40)"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/card_team_border"
            android:padding="16dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Golden Point"
                android:textSize="18sp"
                android:textColor="#FFFFFF" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchGoldenPoint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Next point wins the game at 40-40"
            android:textSize="14sp"
            android:textColor="#AAAAAA"
            android:layout_marginBottom="32dp" />

        <!-- Number of Sets -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Number of Sets"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <RadioGroup
            android:id="@+id/rgSets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <RadioButton
                android:id="@+id/rbSets1"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="1"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:button="@null"
                android:background="@drawable/radio_button_selector"
                android:layout_marginEnd="8dp"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rbSets3"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="3"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:button="@null"
                android:background="@drawable/radio_button_selector"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp" />

            <RadioButton
                android:id="@+id/rbSets5"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="5"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:button="@null"
                android:background="@drawable/radio_button_selector"
                android:layout_marginStart="8dp" />
        </RadioGroup>

        <TextView
            android:id="@+id/tvSetsInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Best of 3"
            android:textSize="14sp"
            android:textColor="#AAAAAA"
            android:layout_marginBottom="32dp" />

        <!-- Team Names -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Team A"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/edtTeamA"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="Team A"
            android:text="Team A"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:background="@drawable/card_team_border"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="32dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Team B"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/edtTeamB"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="Team B"
            android:text="Team B"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:background="@drawable/card_team_border"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btnStartGame"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:text="Start Game"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_rounded_teal" />

    </LinearLayout>
</ScrollView>
